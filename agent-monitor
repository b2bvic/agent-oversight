#!/usr/bin/env python3
# agent-monitor — local Claude and Codex process and token-usage observer
# Requires Python 3.11+. Version 0.2.0 (unreleased).
"""Observe running Claude/Codex processes and recorded token usage.

Reads local session JSONL only. Selects usage by event timestamps, not file
mtime. Does not estimate cost.
"""

