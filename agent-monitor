@dataclass
class ProviderUsage:
    observed: bool
    sessions: int | None = None
    input_tokens: int | None = None
    output_tokens: int | None = None
    cache_creation_input_tokens: int | None = None
    cache_read_input_tokens: int | None = None
    cached_input_tokens: int | None = None
    reasoning_output_tokens: int | None = None

    def as_dict(self, provider: str) -> dict[str, Any]:
        if not self.observed:
            return {"observed": False}
        data: dict[str, Any] = {
            "observed": True,
            "sessions": self.sessions,
            "input_tokens": self.input_tokens,
            "output_tokens": self.output_tokens,
        }
        if provider == "claude":
            data["cache_creation_input_tokens"] = self.cache_creation_input_tokens
            data["cache_read_input_tokens"] = self.cache_read_input_tokens
        else:
            data["cached_input_tokens"] = self.cached_input_tokens
            data["reasoning_output_tokens"] = self.reasoning_output_tokens
        return data


