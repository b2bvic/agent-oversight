@dataclass
class TokenUsage:
    input_tokens: int = 0
    output_tokens: int = 0
    cache_creation_input_tokens: int = 0
    cache_read_input_tokens: int = 0
    cached_input_tokens: int = 0
    reasoning_output_tokens: int = 0

    def add(self, other: TokenUsage) -> None:
        self.input_tokens += other.input_tokens
        self.output_tokens += other.output_tokens
        self.cache_creation_input_tokens += other.cache_creation_input_tokens
        self.cache_read_input_tokens += other.cache_read_input_tokens
        self.cached_input_tokens += other.cached_input_tokens
        self.reasoning_output_tokens += other.reasoning_output_tokens

    def minus_clamped(self, other: TokenUsage) -> TokenUsage:
        return TokenUsage(
            input_tokens=max(0, self.input_tokens - other.input_tokens),
            output_tokens=max(0, self.output_tokens - other.output_tokens),
            cache_creation_input_tokens=max(
                0, self.cache_creation_input_tokens - other.cache_creation_input_tokens
            ),
            cache_read_input_tokens=max(
                0, self.cache_read_input_tokens - other.cache_read_input_tokens
            ),
            cached_input_tokens=max(0, self.cached_input_tokens - other.cached_input_tokens),
            reasoning_output_tokens=max(
                0, self.reasoning_output_tokens - other.reasoning_output_tokens
            ),
        )

    def input_reset(self, previous: TokenUsage) -> bool:
        return self.input_tokens < previous.input_tokens

    def billed_tokens(self) -> int:
        """Uncached input plus output. Cache fields stay out of this total."""
        return self.input_tokens + self.output_tokens

    def has_counts(self) -> bool:
        return any((
            self.input_tokens,
            self.output_tokens,
            self.cache_creation_input_tokens,
            self.cache_read_input_tokens,
            self.cached_input_tokens,
            self.reasoning_output_tokens,
        ))


@dataclass
class MonitorError:
    kind: str
    message: str
    provider: str | None = None
    path: str | None = None
    line: int | None = None

    def as_dict(self) -> dict[str, Any]:
        data: dict[str, Any] = {"kind": self.kind, "message": self.message}
        if self.provider is not None:
            data["provider"] = self.provider
        if self.path is not None:
            data["path"] = self.path
        if self.line is not None:
            data["line"] = self.line
        return data


@dataclass
class Coverage:
    status: str
    detail: str = ""

    def as_dict(self) -> dict[str, str]:
        data = {"status": self.status}
        if self.detail:
            data["detail"] = self.detail
        return data


@dataclass
class ProcessRow:
    pid: int
    provider: str
    cpu: str
    mem: str
    etime: str
    command: str
    comm: str = ""

    def as_dict(self) -> dict[str, Any]:
        return {
            "pid": self.pid,
