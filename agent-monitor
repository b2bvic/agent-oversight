            "errors": [item.as_dict() for item in self.errors],
            "processes": [item.as_dict() for item in self.processes],
            "usage": {
                name: payload.as_dict(name) for name, payload in self.usage.items()
            },
        }


class InvalidUsage(Exception):
    """A record advertised usage fields that could not be parsed."""


